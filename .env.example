# Environment Configuration for SLOT Platform

PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=slot_user
DB_PASSWORD=slot_password
DB_DATABASE=slot_db
DB_SYNCHRONIZE=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=super_secret_slot_jwt_key_2026
JWT_EXPIRATION=86400s
JWT_REFRESH_SECRET=super_secret_slot_refresh_key_2026
JWT_REFRESH_EXPIRATION=604800s

# Booking Hold Settings
BOOKING_HOLD_SECONDS=300

# OTP Provider Settings (Development Mode)
OTP_PROVIDER=dev
DEV_DEFAULT_OTP=123456
