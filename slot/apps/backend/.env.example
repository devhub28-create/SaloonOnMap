NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=slot_user
DB_PASSWORD=change-me
DB_DATABASE=slot_db
DB_SYNCHRONIZE=false

JWT_SECRET=change-me
OTP_PROVIDER=development
# Production must use msg91 or twilio. The API refuses the development
# provider when NODE_ENV=production or VERCEL is set.
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# OTP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# DEV_DEFAULT_OTP=000000

# Required by POST /api/v1/auth/login-admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_PHONE=+910000000000
